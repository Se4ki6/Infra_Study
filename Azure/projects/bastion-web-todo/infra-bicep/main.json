  "variables": {
    "$fxv#0": "#cloud-config\npackage_update: true\npackages:\n  - nginx\n\nwrite_files:\n  - path: /var/www/html/index.html\n    owner: root:root\n    permissions: '0644'\n    content: |\n      <!doctype html>\n      <html lang=\"en\">\n      <head>\n        <meta charset=\"utf-8\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n        <title>Private TODO</title>\n        <style>\n          :root {\n            color-scheme: light dark;\n            font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n          }\n          body {\n            margin: 0;\n            min-height: 100vh;\n            display: grid;\n            place-items: center;\n            background: #eef2f7;\n            color: #172033;\n          }\n          main {\n            width: min(680px, calc(100vw - 32px));\n            background: #ffffff;\n            border: 1px solid #d7deea;\n            border-radius: 8px;\n            padding: 24px;\n            box-shadow: 0 18px 45px rgba(23, 32, 51, 0.12);\n          }\n          h1 {\n            margin: 0 0 18px;\n            font-size: 28px;\n            letter-spacing: 0;\n          }\n          form {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 18px;\n          }\n          input {\n            flex: 1;\n            min-width: 0;\n            border: 1px solid #b7c0cf;\n            border-radius: 6px;\n            padding: 12px 14px;\n            font-size: 16px;\n          }\n          button {\n            border: 0;\n            border-radius: 6px;\n            padding: 12px 16px;\n            background: #1262b3;\n            color: #fff;\n            font-weight: 700;\n            cursor: pointer;\n          }\n          ul {\n            list-style: none;\n            margin: 0;\n            padding: 0;\n          }\n          li {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            gap: 12px;\n            padding: 12px 0;\n            border-top: 1px solid #e4e9f1;\n          }\n          li.done span {\n            color: #687589;\n            text-decoration: line-through;\n          }\n          .row-actions {\n            display: flex;\n            gap: 8px;\n          }\n          .secondary {\n            background: #e8edf5;\n            color: #1c2b41;\n          }\n          @media (max-width: 520px) {\n            form {\n              flex-direction: column;\n            }\n            li {\n              align-items: flex-start;\n              flex-direction: column;\n            }\n          }\n        </style>\n      </head>\n      <body>\n        <main>\n          <h1>Private TODO</h1>\n          <form id=\"todo-form\">\n            <input id=\"todo-input\" autocomplete=\"off\" placeholder=\"Add a task\" required>\n            <button type=\"submit\">Add</button>\n          </form>\n          <ul id=\"todo-list\"></ul>\n        </main>\n        <script>\n          const storageKey = \"private-todo-items\";\n          const form = document.querySelector(\"#todo-form\");\n          const input = document.querySelector(\"#todo-input\");\n          const list = document.querySelector(\"#todo-list\");\n          let items = JSON.parse(localStorage.getItem(storageKey) || \"[]\");\n\n          function save() {\n            localStorage.setItem(storageKey, JSON.stringify(items));\n          }\n\n          function render() {\n            list.innerHTML = \"\";\n            items.forEach((item, index) => {\n              const li = document.createElement(\"li\");\n              li.className = item.done ? \"done\" : \"\";\n\n              const text = document.createElement(\"span\");\n              text.textContent = item.text;\n\n              const actions = document.createElement(\"div\");\n              actions.className = \"row-actions\";\n\n              const toggle = document.createElement(\"button\");\n              toggle.className = \"secondary\";\n              toggle.type = \"button\";\n              toggle.textContent = item.done ? \"Undo\" : \"Done\";\n              toggle.addEventListener(\"click\", () => {\n                items[index].done = !items[index].done;\n                save();\n                render();\n              });\n\n              const remove = document.createElement(\"button\");\n              remove.type = \"button\";\n              remove.textContent = \"Delete\";\n              remove.addEventListener(\"click\", () => {\n                items.splice(index, 1);\n                save();\n                render();\n              });\n\n              actions.append(toggle, remove);\n              li.append(text, actions);\n              list.append(li);\n            });\n          }\n\n          form.addEventListener(\"submit\", (event) => {\n            event.preventDefault();\n            const text = input.value.trim();\n            if (!text) return;\n            items.unshift({ text, done: false });\n            input.value = \"\";\n            save();\n            render();\n          });\n\n          render();\n        </script>\n      </body>\n      </html>\n\nruncmd:\n  - systemctl enable nginx\n  - systemctl restart nginx\n",
